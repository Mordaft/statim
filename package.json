{
  "name": "statim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c test-e2e/playwright.config.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "report:unit": "vite preview --outDir reports/unit --port 4180 --open",
    "report:e2e": "playwright show-report reports/e2e"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "lz4js": "^0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
