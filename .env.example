# Solo desarrollo: destino del proxy de Vite para /wiki
CONFLUENCE_BASE_URL=https://tu-sitio.atlassian.net

# Vacío = mismo origen (proxy de Vite). Con localproxy: http://localhost:8787
VITE_CONFLUENCE_BASE_URL=
VITE_CONFLUENCE_PAGE_ID=

# Metered TURNS sobre TLS (opcional para desarrollo/tests). En producción se informan en la pantalla de acceso y nunca se guardan.
VITE_METERED_DOMAIN=
VITE_METERED_API_KEY=

# TURN tradicional (coturn). Estas credenciales quedan visibles en el bundle.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
